#!/usr/bin/env python3
"""Drop-in `ego-browser` for hosts without ego lite.

Installed on the agent host as /usr/local/bin/ego-browser so the stock
ego-browser skill works unchanged: the agent still writes

    ego-browser nodejs <<'EOF' ... EOF

but the script is forwarded to the ego-bridge running on the macOS host, run
there against the real ego lite browser, and the results are streamed back.
Screenshots taken on the Mac and files the browser downloads are copied to this
host, with the paths in the output rewritten so the agent can open them locally.

Config: /etc/ego-bridge.conf  (KEY=VALUE)
    EGO_BRIDGE_URL=http://<mac-ip>:8791
    EGO_BRIDGE_TOKEN=...
Environment variables of the same name take precedence.
"""
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

CONF_PATH = os.environ.get("EGO_BRIDGE_CONF", "/etc/ego-bridge.conf")
FILE_DIR = os.environ.get("EGO_BRIDGE_FILE_DIR", "/var/tmp/ego-bridge/files")
DOWNLOAD_DIR = os.environ.get("EGO_BRIDGE_DOWNLOAD_DIR", "/var/tmp/ego-bridge/downloads")
HTTP_TIMEOUT = float(os.environ.get("EGO_BRIDGE_HTTP_TIMEOUT", "620"))
RUN_TIMEOUT = float(os.environ.get("EGO_BRIDGE_RUN_TIMEOUT", "600"))


def load_conf():
    conf = {}
    try:
        with open(CONF_PATH) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                conf[k.strip()] = v.strip()
    except IOError:
        pass
    for k in ("EGO_BRIDGE_URL", "EGO_BRIDGE_TOKEN"):
        if os.environ.get(k):
            conf[k] = os.environ[k]
    return conf


def die(msg, code=127):
    sys.stderr.write("ego-browser (bridge shim): %s\n" % msg)
    sys.exit(code)


def note(msg):
    sys.stderr.write("ego-browser (bridge shim): %s\n" % msg)


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return "%.0f %s" % (n, unit) if unit == "B" else "%.1f %s" % (n, unit)
        n /= 1024.0


def request(url, token, data=None, ctype="application/json"):
    req = urllib.request.Request(url, data=data)
    req.add_header("Authorization", "Bearer " + token)
    if data is not None:
        req.add_header("Content-Type", ctype)
    return urllib.request.urlopen(req, timeout=HTTP_TIMEOUT)


def pull(base, token, mac_path, dest_dir, expected_size=None):
    """Copy one Mac-side file here. Returns the local path, or None."""
    try:
        os.makedirs(dest_dir)
    except OSError:
        pass
    local = os.path.join(dest_dir, os.path.basename(mac_path))
    if expected_size is not None:
        try:
            if os.path.getsize(local) == expected_size:
                return local  # already have this exact file
        except OSError:
            pass
    url = base + "/file?" + urllib.parse.urlencode({"path": mac_path})
    try:
        with request(url, token) as resp:
            blob = resp.read()
        with open(local, "wb") as fh:
            fh.write(blob)
        return local
    except Exception as exc:  # a missing file must never fail the whole run
        note("could not fetch %s: %s" % (mac_path, exc))
        return None


def main():
    conf = load_conf()
    base = (conf.get("EGO_BRIDGE_URL") or "").rstrip("/")
    token = conf.get("EGO_BRIDGE_TOKEN") or ""
    if not base or not token:
        die("EGO_BRIDGE_URL / EGO_BRIDGE_TOKEN missing (looked in %s)" % CONF_PATH)

    args = sys.argv[1:]
    script = "" if sys.stdin.isatty() else sys.stdin.read()

    payload = json.dumps({"args": args, "stdin": script, "timeout": RUN_TIMEOUT}).encode()
    try:
        with request(base + "/run", token, payload) as resp:
            result = json.load(resp)
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", "replace")[:500]
        die("bridge rejected the request (HTTP %s): %s" % (exc.code, detail))
    except urllib.error.URLError as exc:
        die(
            "cannot reach the ego-bridge at %s (%s).\n"
            "Check that the macOS host is awake and the bridge is running." % (base, exc.reason)
        )

    out = result.get("stdout") or ""
    err = result.get("stderr") or ""

    # Screenshots and similar: rewrite the Mac path the script printed so the
    # agent reads the copy that now lives here.
    for art in result.get("artifacts") or []:
        local = pull(base, token, art["path"], FILE_DIR, art.get("size"))
        if local:
            out = out.replace(art["path"], local)
            err = err.replace(art["path"], local)

    sys.stdout.write(out)
    sys.stdout.flush()
    sys.stderr.write(err)

    # Files the browser downloaded on the Mac. The agent never named these, so
    # instead of rewriting paths, report them explicitly.
    synced, oversized = [], []
    for dl in result.get("downloads") or []:
        if dl.get("too_large"):
            oversized.append(dl)
            continue
        local = pull(base, token, dl["path"], DOWNLOAD_DIR, dl.get("size"))
        if local:
            synced.append((local, dl.get("size") or 0))
    if synced:
        note("%d file(s) downloaded by the browser are now available here:" % len(synced))
        for local, size in synced:
            sys.stderr.write("  %s  (%s)\n" % (local, human(size)))
    for dl in oversized:
        note(
            "download too large to sync automatically: %s (%s). Fetch it with "
            "GET /file?path=... if you need it." % (dl["path"], human(dl.get("size") or 0))
        )
    sys.stderr.flush()

    sys.exit(int(result.get("code") or 0))


if __name__ == "__main__":
    main()
